                <CheckBox
                    android:id="@+id/cbUploadTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:checked="false"
                    android:text="اجرای تست آپلود و پایش UDP حین آپلود در تست کامل"
                    android:buttonTint="#0E9F9A"
