<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#101B35">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONITORING"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network monitoring &amp; diagnostics"
                android:textColor="#AFC4D8"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="N"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="#0E9F9A" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#101B35"
        android:padding="6dp">

        <Button
            android:id="@+id/tabTest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تست کامل"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263858"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/tabPlot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تریس / پلاتر"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263858"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/tabChart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="نمودار"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E4966"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/tabFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="فیلترینگ"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0E9F9A"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/tabDns"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DNS"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E4966"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تنظیمات"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1E4966"
            android:minHeight="48dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ───────── پنل تست کامل ───────── -->
        <ScrollView
            android:id="@+id/panelTest"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_card"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:minHeight="92dp"
                    android:gravity="center_vertical"
                    android:text="برای شروع، دکمه‌ی تست را بزنید"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ثبت نتایج و مقایسه اپراتورها"
                    android:textStyle="bold"
                    android:textColor="#17324D"
                    android:layout_marginTop="4dp" />
                <Spinner
                    android:id="@+id/spOperator"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/operator_names" />
                <Button
                    android:id="@+id/btnCompareOperators"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="مقایسه نتایج اپراتورها" />
                <CheckBox
                    android:id="@+id/cbAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="اجرای خودکار پس از اتصال مجدد (اختیاری)" />

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شروع تست" />

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#263746"
                    android:textIsSelectable="true"
                    android:background="@drawable/report_card"
                    android:padding="18dp"
                    android:lineSpacingExtra="10dp"
                    android:lineSpacingMultiplier="1.16"
                    android:textSize="14sp"
                    android:fontFamily="sans"/>

                <Button
                    android:id="@+id/btnCompareTests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="مقایسه دو تست آخر (قبل و بعد از تغییر اینترنت)"
                    android:backgroundTint="#243B63"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnShareTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ارسال گزارش" />

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="گزارش‌های ذخیره‌شده" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل تریس / پلاتر ───────── -->
        <ScrollView
            android:id="@+id/panelPlot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="هاست یا IP مقصد"
                    android:inputType="textUri"
                    android:layoutDirection="ltr"
                    android:text="8.8.8.8"
                    android:textDirection="ltr" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbIcmp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Trace (ICMP)" />

                    <RadioButton
                        android:id="@+id/rbTcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TCP Ping" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="پورت (فقط برای حالت TCP)"
                    android:inputType="number"
                    android:layoutDirection="ltr"
                    android:text="443" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="فاصله به‌روزرسانی نمودار (ثانیه)"
                    android:textStyle="bold"
                    android:textColor="#263238" />

                <EditText
                    android:id="@+id/etRefreshSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true"
                    android:text="1"
                    android:hint="عدد بین ۱ تا ۶۰ ثانیه" />

                <Button
                    android:id="@+id/btnPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شروع" />

                <TextView
                    android:id="@+id/tvPlotInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#222222"
                    android:textSize="13sp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graph"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:gravity="start"
                    android:textColor="#17243A"
                    android:textIsSelectable="true"
                    android:textSize="10sp"
                    android:lineSpacingExtra="5dp"
                    android:fontFamily="monospace"
                    android:typeface="monospace"
                    android:padding="12dp"
                    android:background="@drawable/report_card" />

                <Button
                    android:id="@+id/btnSharePlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ارسال گزارش" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل مستقل نمودار ───────── -->
        <ScrollView
            android:id="@+id/panelChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نمودار زنده کیفیت ارتباط"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#17324D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="تأخیر پاسخ در طول زمان؛ علامت قرمز نشان‌دهنده از دست رفتن بسته است."
                    android:textColor="#607080"
                    android:textSize="13sp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphLarge"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphJitter"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphLoss"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="هر سه نمودار هم‌زمان به‌روزرسانی می‌شوند. فاصله Refresh را از تب «تریس / پلاتر» تنظیم کنید."
                    android:textColor="#455A64"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل تشخیص محدودیت دسترسی ───────── -->
        <ScrollView
            android:id="@+id/panelFilter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تشخیص محدودیت دسترسی"
                    android:textColor="#102A43"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="آزمون DNS، اتصال TCP/443 و پاسخ HTTPS؛ نتیجه احتمالی است و به‌تنهایی اثبات فیلترینگ نیست."
                    android:textColor="#526579"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="دامنه‌های آماده"
                    android:textColor="#17324D"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterSite"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/filter_sites" />
                <EditText
                    android:id="@+id/etFilterDomain"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:hint="یا دامنه دلخواه مثل example.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:padding="12dp"
                    android:background="@drawable/input_card" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="اپراتوری که همین حالا به اینترنت آن متصل هستید"
                    android:textColor="#17324D"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterOperator"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:entries="@array/operator_names" />
                <Button
                    android:id="@+id/btnFilterCheck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:text="شروع بررسی دسترسی"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#087E8B" />
                <ProgressBar
                    android:id="@+id/filterProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="مقایسه دو اپراتور"
                    android:textColor="#17324D"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterCompareA"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/operator_names" />
                <Spinner
                    android:id="@+id/spFilterCompareB"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/operator_names" />
                <Button
                    android:id="@+id/btnCompareFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نمایش مقایسه اپراتورها"
                    android:backgroundTint="#17324D"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/btnShareFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="اشتراک‌گذاری گزارش بررسی" />
                <TextView
                    android:id="@+id/tvFilterResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="18dp"
                    android:background="@drawable/report_card"
                    android:text="نتیجه آزمون در این قسمت نمایش داده می‌شود. برای مقایسه اپراتورها، همین تست را روی هر اتصال جداگانه اجرا کنید."
                    android:textColor="#243B53"
                    android:textSize="15sp"
                    android:lineSpacingExtra="7dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>


        <ScrollView
            android:id="@+id/panelDns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DNS Explorer"
                    android:textColor="#102A43"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="استعلام تکی یا گروهی رکوردها همراه با نمودار تعداد پاسخ‌ها؛ ارتباط امن DNS-over-HTTPS."
                    android:textColor="#526579"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDnsLookup"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:hint="دامنه؛ مثال example.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:padding="12dp"
                    android:background="@drawable/input_card" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="DNS Server انتخابی"
                    android:textStyle="bold"
                    android:textColor="#17324D" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etDnsServer"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="IP سرور DNS مثل 192.168.1.1"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:layoutDirection="ltr"
                        android:textDirection="ltr"
                        android:padding="10dp"
                        android:background="@drawable/input_card" />
                    <Button
                        android:id="@+id/btnAddDnsServer"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="افزودن"
                        android:minWidth="72dp" />
                </LinearLayout>
                <Spinner
                    android:id="@+id/spDnsServer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
                <Spinner
                    android:id="@+id/spDnsType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/dns_record_types" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="پایش پاسخ رکوردها (۱۰ نمونه متوالی)"
                    android:textStyle="bold"
                    android:textColor="#17324D" />
                <LinearLayout
                    android:id="@+id/dnsChartsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnDnsLookup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="استعلام رکورد DNS"
                    android:backgroundTint="#087E8B"
                    android:textColor="#FFFFFF" />
                <TextView
                    android:id="@+id/tvDnsLookupResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="18dp"
                    android:background="@drawable/report_card"
                    android:text="نتیجه استعلام در این قسمت نمایش داده می‌شود."
                    android:textColor="#243B53"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل تنظیمات ───────── -->
        <ScrollView
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="هر خط یک مورد. خطی که با # شروع شود نادیده گرفته می‌شود."
                    android:textColor="#555555" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="اهداف پینگ (هر خط یک مورد؛ host یا host:port برای حالت TCP)"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سرورهای DNS برای تست (هر خط یک IP)"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDnsServers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="دامنه‌های تست DNS"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDnsDomains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سایت‌های بین‌المللی برای تست دسترسی"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSitesIntl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سایت‌های داخلی برای تست دسترسی"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSitesLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="آدرس فایل‌های تست سرعت دانلود"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/cbSpeedTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="false"
                    android:text="اجرای تست سرعت دانلود در تست کامل" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="در حالت خاموش، تست کامل بدون دانلود فایل حجیم اجرا می‌شود."
                    android:textColor="#607080"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ذخیره" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="بازگشت به پیش‌فرض" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
