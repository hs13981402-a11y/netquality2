<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:background="#F3F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="#101B35">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MONITORING"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="19sp"
                android:letterSpacing="0.08" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network monitoring &amp; diagnostics"
                android:textColor="#AFC4D8"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="N"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="#0E9F9A" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:fillViewport="false"
        android:background="#101B35"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <Button
                android:id="@+id/tabTest"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="88dp"
                android:text="تست کامل"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0E9F9A"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabPlot"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="104dp"
                android:text="تریس / پلاتر"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabChart"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="82dp"
                android:text="نمودار"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabFilter"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="88dp"
                android:text="فیلترینگ"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabDns"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="68dp"
                android:text="DNS"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabPacketLoss"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:minWidth="92dp"
                android:text="Packet Loss"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <Button
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minWidth="88dp"
                android:text="تنظیمات"
                android:textSize="12sp"
                android:textColor="#DCE8F4"
                android:backgroundTint="#263858"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ───────── پنل تست کامل ───────── -->
        <ScrollView
            android:id="@+id/panelTest"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel_card"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp"
                    android:minHeight="92dp"
                    android:gravity="center_vertical"
                    android:text="برای شروع، دکمه‌ی تست را بزنید"
                    android:textColor="#17324D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:elevation="2dp"
                    android:lineSpacingExtra="4dp" />

                <CheckBox
                    android:id="@+id/cbAuto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="اجرای خودکار پس از اتصال مجدد (اختیاری)" />

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شروع تست" 
                    android:minHeight="54dp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0E9F9A"/>

                <ProgressBar
                    android:id="@+id/progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#263746"
                    android:textIsSelectable="true"
                    android:background="@drawable/report_card"
                    android:padding="18dp"
                    android:lineSpacingExtra="10dp"
                    android:lineSpacingMultiplier="1.16"
                    android:textSize="14sp"
                    android:fontFamily="sans"
                    android:elevation="1dp"/>

                <Button
                    android:id="@+id/btnCompareTests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="مقایسه دو تست آخر (قبل و بعد از تغییر اینترنت)"
                    android:backgroundTint="#243B63"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnShareTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="ارسال گزارش" 
                    android:textColor="#17324D"
                    android:backgroundTint="#E4ECF4"/>

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="گزارش‌های ذخیره‌شده" 
                    android:textColor="#17324D"
                    android:backgroundTint="#E4ECF4"/>
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل تریس / پلاتر ───────── -->
        <ScrollView
            android:id="@+id/panelPlot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
                    android:clipToPadding="false"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="هاست یا IP مقصد"
                    android:inputType="textUri"
                    android:layoutDirection="ltr"
                    android:text="8.8.8.8"
                    android:textDirection="ltr"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbIcmp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Trace (ICMP)" />

                    <RadioButton
                        android:id="@+id/rbTcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TCP Ping" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="پورت (فقط برای حالت TCP)"
                    android:inputType="number"
                    android:layoutDirection="ltr"
                    android:text="443"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="فاصله به‌روزرسانی نمودار (ثانیه)"
                    android:textStyle="bold"
                    android:textColor="#263238" />

                <EditText
                    android:id="@+id/etRefreshSeconds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:singleLine="true"
                    android:text="1"
                    android:hint="عدد بین ۱ تا ۶۰ ثانیه"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>

                <Button
                    android:id="@+id/btnPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="شروع"
                    android:backgroundTint="#0E9F9A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:minHeight="54dp"/>

                <TextView
                    android:id="@+id/tvPlotInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#526579"
                    android:textSize="13sp"
                    android:background="@drawable/report_card"
                    android:padding="12dp"
                    android:lineSpacingExtra="4dp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graph"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:gravity="start"
                    android:textColor="#17243A"
                    android:textIsSelectable="true"
                    android:textSize="10sp"
                    android:lineSpacingExtra="3dp"
                    android:fontFamily="monospace"
                    android:typeface="monospace"
                    android:padding="14dp"
                    android:background="@drawable/report_card"
                    android:elevation="1dp"/>

                <Button
                    android:id="@+id/btnSharePlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="ارسال گزارش" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل مستقل نمودار ───────── -->
        <ScrollView
            android:id="@+id/panelChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
                    android:clipToPadding="false"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="پایش زنده کیفیت ارتباط"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#17324D" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="تأخیر پاسخ در طول زمان؛ نقاط قرمز نشان‌دهنده بسته‌های بدون پاسخ هستند."
                    android:textColor="#607080"
                    android:textSize="13sp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphLarge"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphJitter"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <com.netquality.app.GraphView
                    android:id="@+id/graphLoss"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/report_card"
                    android:padding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="هر سه نمودار هم‌زمان به‌روزرسانی می‌شوند. فاصله Refresh را از تب «تریس / پلاتر» تنظیم کنید."
                    android:textColor="#455A64"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل تشخیص محدودیت دسترسی ───────── -->
        <ScrollView
            android:id="@+id/panelFilter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
                    android:clipToPadding="false"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="تشخیص محدودیت دسترسی"
                    android:textColor="#102A43"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="آزمون DNS، اتصال TCP/443 و پاسخ HTTPS؛ نتیجه احتمالی است و به‌تنهایی اثبات فیلترینگ نیست."
                    android:textColor="#526579"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="دامنه‌های آماده"
                    android:textColor="#17324D"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterSite"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/filter_sites" />
                <EditText
                    android:id="@+id/etFilterDomain"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:hint="یا دامنه دلخواه مثل example.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:padding="12dp"
                    android:background="@drawable/input_card"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="اپراتوری که همین حالا به اینترنت آن متصل هستید"
                    android:textColor="#17324D"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterOperator"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:entries="@array/operator_names" />
                <Button
                    android:id="@+id/btnFilterCheck"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:text="شروع بررسی دسترسی"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0E9F9A"
                    android:minHeight="54dp"/>
                <ProgressBar
                    android:id="@+id/filterProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="مقایسه دو اپراتور"
                    android:textColor="#17324D"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <Spinner
                    android:id="@+id/spFilterCompareA"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/operator_names" />
                <Spinner
                    android:id="@+id/spFilterCompareB"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/operator_names" />
                <Button
                    android:id="@+id/btnCompareFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="نمایش مقایسه اپراتورها"
                    android:backgroundTint="#17324D"
                    android:textColor="#FFFFFF" />
                <Button
                    android:id="@+id/btnShareFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="اشتراک‌گذاری گزارش بررسی" />
                <TextView
                    android:id="@+id/tvFilterResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="18dp"
                    android:background="@drawable/report_card"
                    android:text="گزارش استعلام DNS در این قسمت نمایش داده می‌شود. برای مقایسه اپراتورها، همین تست را روی هر اتصال جداگانه اجرا کنید."
                    android:textColor="#243B53"
                    android:textSize="15sp"
                    android:lineSpacingExtra="7dp"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </ScrollView>


        <ScrollView
            android:id="@+id/panelDns"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
                    android:clipToPadding="false"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DNS Explorer"
                    android:textColor="#102A43"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="استعلام مستقیم از DNS انتخاب‌شده، پایش زمان پاسخ و نمایش وضعیت رکوردهای مختلف."
                    android:textColor="#526579"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDnsLookup"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:hint="دامنه؛ مثال example.com"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:padding="12dp"
                    android:background="@drawable/input_card"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="DNS Server انتخابی"
                    android:textStyle="bold"
                    android:textColor="#17324D" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/etDnsServer"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:hint="IP سرور DNS مثل 192.168.1.1"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:layoutDirection="ltr"
                        android:textDirection="ltr"
                        android:padding="12dp"
                        android:background="@drawable/input_card"
                    android:minHeight="52dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6"/>
                    <Button
                        android:id="@+id/btnAddDnsServer"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="افزودن"
                        android:minWidth="72dp" />
                </LinearLayout>
                <Spinner
                    android:id="@+id/spDnsServer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
                <Spinner
                    android:id="@+id/spDnsType"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:entries="@array/dns_record_types" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="نمودار زنده زمان پاسخ DNS · پایش پیوسته"
                    android:textStyle="bold"
                    android:textColor="#17324D" />
                <LinearLayout
                    android:id="@+id/dnsChartsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp" />
                <Button
                    android:id="@+id/btnDnsLookup"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="شروع پایش DNS"
                    android:backgroundTint="#0E9F9A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:minHeight="54dp"/>
                <TextView
                    android:id="@+id/tvDnsLookupResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:padding="16dp"
                    android:background="@drawable/report_card"
                    android:text="نتیجه استعلام در این قسمت نمایش داده می‌شود."
                    android:textColor="#243B53"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp"
                    android:textIsSelectable="true"
                    android:elevation="1dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- ───────── پنل اختصاصی Packet Loss ───────── -->
        <ScrollView
            android:id="@+id/panelPacketLoss"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Packet Loss Lab"
                    android:textColor="#102A43"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="آزمون‌های واقعی UDP با موتور iperf3؛ آمار افت بسته و Jitter از گزارش سرور دریافت می‌شود."
                    android:textColor="#607080"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="سرور iperf3 (سرور باید از قبل در حالت Server فعال باشد)"
                    android:textColor="#17324D"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/etIperfHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="آدرس IP یا دامنه سرور"
                    android:singleLine="true"
                    android:inputType="textUri"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:text="speedtest.uninet.az"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:textColor="#172B43" />
                <EditText
                    android:id="@+id/etIperfPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="پورت iperf3 (پیش‌فرض 5201)"
                    android:singleLine="true"
                    android:inputType="number"
                    android:layoutDirection="ltr"
                    android:textDirection="ltr"
                    android:text="5201"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:textColor="#172B43" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/panel_card">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="۱. Packet Loss در UDP"
                        android:textColor="#17324D"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="ارسال جریان UDP با نرخ هدف 1 Mbps به سرور iperf3 و محاسبه Packet Loss واقعی از گزارش سمت سرور."
                        android:textColor="#607080"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnUdpLoss"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="اجرای تست UDP"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#17324D" />
                    <TextView
                        android:id="@+id/tvUdpLossResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="12dp"
                        android:background="@drawable/report_card"
                        android:text="نتیجه تست UDP هنوز ثبت نشده است."
                        android:textColor="#243B53"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/panel_card">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="۲. افت پروب UDP حین Upload"
                        android:textColor="#17324D"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="ارسال جریان UDP از گوشی به سرور با نرخ هدف 10 Mbps؛ افت بسته‌های مسیر Upload مستقیماً از گزارش iperf3 خوانده می‌شود."
                        android:textColor="#607080"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btnUploadLoss"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:text="اجرای تست UDP زیر بار آپلود"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#0E9F9A" />
                    <TextView
                        android:id="@+id/tvUploadLossResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:padding="12dp"
                        android:background="@drawable/report_card"
                        android:text="نتیجه تست زیر بار آپلود هنوز ثبت نشده است."
                        android:textColor="#243B53"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>        <!-- ───────── پنل تنظیمات ───────── -->
        <ScrollView
            android:id="@+id/panelSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
                    android:clipToPadding="false"
                    android:scrollbarStyle="outsideOverlay"
                    android:fadeScrollbars="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="هر خط یک مورد. خطی که با # شروع شود نادیده گرفته می‌شود."
                    android:textColor="#555555" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="اهداف پینگ (هر خط یک مورد؛ host یا host:port برای حالت TCP)"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سرورهای DNS برای تست (هر خط یک IP)"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDnsServers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="دامنه‌های تست DNS"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etDnsDomains"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سایت‌های بین‌المللی برای تست دسترسی"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSitesIntl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="سایت‌های داخلی برای تست دسترسی"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSitesLocal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="آدرس فایل‌های تست سرعت دانلود"
                android:textColor="#222222"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions|textUri"
                android:layoutDirection="ltr"
                android:minLines="3"
                android:textDirection="ltr"
                android:textSize="14sp"
                    android:background="@drawable/input_card"
                    android:padding="12dp"
                    android:minHeight="54dp"
                    android:textColor="#172B43"
                    android:textColorHint="#8293A6" />

                <CheckBox
                    android:id="@+id/cbSpeedTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:checked="false"
                    android:text="اجرای تست سرعت دانلود در تست کامل"
                    android:buttonTint="#0E9F9A"
                    android:textColor="#17324D"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="در حالت خاموش، تست کامل بدون دانلود فایل حجیم اجرا می‌شود."
                    android:textColor="#607080"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="ذخیره"
                    android:backgroundTint="#0E9F9A"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:minHeight="52dp" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="بازگشت به پیش‌فرض"
                    android:backgroundTint="#E4ECF4"
                    android:textColor="#17324D"
                    android:minHeight="48dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
