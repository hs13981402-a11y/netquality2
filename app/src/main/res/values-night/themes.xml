<resources>
    <style name="Theme.NetQuality" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#14243A</item>
        <item name="colorPrimaryDark">#070E1B</item>
        <item name="colorAccent">#20B8AE</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#070E1B</item>
        <item name="android:navigationBarColor">#070E1B</item>
        <item name="android:windowBackground">#0B1220</item>
        <item name="android:colorButtonNormal">#24364D</item>
        <item name="colorControlHighlight">#31516B</item>
        <item name="android:textColorPrimary">#E6EDF7</item>
        <item name="buttonStyle">@style/MonitoringButton</item>
        <item name="android:editTextStyle">@style/MonitoringEditText</item>
    </style>
    <style name="MonitoringButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#24364D</item>
        <item name="android:textColor">#E6EDF7</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>
    <style name="MonitoringEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">#E6EDF7</item>
        <item name="android:textColorHint">#91A4BB</item>
        <item name="android:padding">12dp</item>
        <item name="android:backgroundTint">#52677F</item>
    </style>
</resources>
